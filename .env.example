# Customer Segmentation local environment template
# Copy this file to `.env` for local-only overrides.
# Keep `.env` uncommitted. Do not store credentials, tokens, or private customer data here.
#
# The project CLI accepts explicit flags; these values document the recommended local
# defaults and can be reused by shell scripts, notebooks, or future automation.

# ---------------------------------------------------------------------------
# Data inputs
# ---------------------------------------------------------------------------

# Raw CA2 customer CSV used by the notebook and training workflow.
CUSTOMER_DATA_PATH=data/raw/CA2-Customer-Data.csv

# Optional processed data location if you export cleaned intermediate datasets.
PROCESSED_DATA_DIR=data/processed

# ---------------------------------------------------------------------------
# Training configuration
# ---------------------------------------------------------------------------

# Default K-Means segment count used by the packaged workflow and original analysis.
KMEANS_N_CLUSTERS=6

# Reproducibility seed used by scikit-learn models.
RANDOM_STATE=42

# Set to true only when you intentionally want to keep IQR-detected income outliers.
KEEP_OUTLIERS=false

# ---------------------------------------------------------------------------
# Generated artifacts
# ---------------------------------------------------------------------------

# Trained model artifact.
MODEL_OUTPUT_PATH=models/customer_segmentation_kmeans.joblib

# Evaluation metrics JSON.
METRICS_OUTPUT_PATH=reports/metrics.json

# Labelled customer segments CSV.
SEGMENTS_OUTPUT_PATH=reports/customer_segments.csv

# Generated visual output folder.
FIGURES_OUTPUT_DIR=reports/figures

# ---------------------------------------------------------------------------
# Runtime behavior
# ---------------------------------------------------------------------------

# Use INFO for normal local runs; DEBUG is useful while extending the package.
LOG_LEVEL=INFO

# Keep Python warning output visible during development.
PYTHONWARNINGS=default
